# X-SpectralNIDS Configuration
# Demo default is model_b (exploratory feature-vector FFT magnitudes).
# Selectable: model_b, model_a, dummy
MODEL_NAME=model_b

# Model artifact bundle directory
MODEL_DIR=backend/models

# Replay flow data CSV
REPLAY_CSV=backend/data/replay_sample.csv

# Replay stream cadence (bounded 1-second ticks)
ROWS_PER_TICK=10
TICK_SECONDS=1.0

# Allowed frontend origin(s)
FRONTEND_ORIGINS=http://localhost:5173

