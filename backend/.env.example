# X-SpectralNIDS Backend Configuration
# Demo default is model_b (exploratory feature-vector FFT magnitudes).
# Selectable: model_b, model_a, dummy
MODEL_NAME=model_b

# Model artifact bundle directory
MODEL_DIR=models

# Replay flow data CSV (gitignored sample)
REPLAY_CSV=data/replay_sample.csv

# Replay stream cadence (bounded 1-second ticks)
ROWS_PER_TICK=10
TICK_SECONDS=1.0

# Allowed frontend origin(s)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

